# Copy to .env and adjust.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/novacart
JWT_SECRET=replace-with-a-long-random-string

# Where the storefront runs (used for CORS and sitemap links). Comma-separate several.
CLIENT_URL=http://localhost:5173

# Seeded admin account (npm run seed)
ADMIN_EMAIL=admin@novacart.pk
ADMIN_PASSWORD=Admin@123

# Optional: enables the card payment intent endpoint. Leave empty for cash on delivery only.
STRIPE_SECRET_KEY=

# Set to true to serve frontend/dist from this server (single-server deploy)
SERVE_FRONTEND=false

# Firebase project used for "Continue with Google" (ID tokens are verified against it)
FIREBASE_PROJECT_ID=novacart-9b618
